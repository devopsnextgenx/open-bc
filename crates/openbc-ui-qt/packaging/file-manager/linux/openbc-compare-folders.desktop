[Desktop Entry]
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
MimeType=inode/directory;
Actions=OpenBCSelectLeftFolder;
X-KDE-Submenu=openbc
Icon=io.github.devopsnextgenx.open-bc

# "openbc: Compare To Left Folder" is NOT listed here: the running OpenBC writes
# ~/.local/share/kio/servicemenus/openbc-compare-to-left-folder.desktop while a left folder is selected.

[Desktop Action OpenBCSelectLeftFolder]
Name=openbc: Select Left Folder
Icon=folder-open
Exec=@FM_LAUNCHER@ --select-left-folder %f
