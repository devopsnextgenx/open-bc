Windows Registry Editor Version 5.00

; Classic Explorer context-menu verbs for OpenBC (per user). Replace C:\\Program Files\\OpenBC with the
; install folder. On Windows 11 these appear under "Show more options".
; Uninstall: delete the OpenBC.* keys below.
;
; "openbc: Compare To Left Folder/File" is NOT in this file: the running OpenBC creates the verb
; (HKCU\\Software\\Classes\\Directory|*\\shell\\OpenBC.CompareToLeft) while a left item is selected and
; removes it when the selection is cleared or OpenBC exits, so it is only shown when it can work.

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\OpenBC.SelectLeft]
@="openbc: Select Left Folder"
"Icon"="C:\\Program Files\\OpenBC\\openbc.exe"
[HKEY_CURRENT_USER\Software\Classes\Directory\shell\OpenBC.SelectLeft\command]
@="\"C:\\Program Files\\OpenBC\\openbc.exe\" --select-left-folder \"%1\""

[HKEY_CURRENT_USER\Software\Classes\*\shell\OpenBC.SelectLeft]
@="openbc: Select Left File"
"Icon"="C:\\Program Files\\OpenBC\\openbc.exe"
[HKEY_CURRENT_USER\Software\Classes\*\shell\OpenBC.SelectLeft\command]
@="\"C:\\Program Files\\OpenBC\\openbc.exe\" --select-left-file \"%1\""

; Two selected items of the same kind (Player model: ONE process receives all selected paths).
[HKEY_CURRENT_USER\Software\Classes\*\shell\OpenBC.Compare]
@="openbc: Compare"
"Icon"="C:\\Program Files\\OpenBC\\openbc.exe"
"MultiSelectModel"="Player"
[HKEY_CURRENT_USER\Software\Classes\*\shell\OpenBC.Compare\command]
@="\"C:\\Program Files\\OpenBC\\openbc.exe\" %*"

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\OpenBC.Compare]
@="openbc: Compare"
"Icon"="C:\\Program Files\\OpenBC\\openbc.exe"
"MultiSelectModel"="Player"
[HKEY_CURRENT_USER\Software\Classes\Directory\shell\OpenBC.Compare\command]
@="\"C:\\Program Files\\OpenBC\\openbc.exe\" %*"
