# Flatpak manifest used by `scripts/build.sh -p lin -s flatpak`.
# For Flathub/offline builds, generate cargo-sources.json from the pinned
# open-bc Cargo.lock with flatpak-cargo-generator before building.
app-id: io.github.devopsnextgenx.open-bc
runtime: org.kde.Platform
runtime-version: '6.10'
sdk: org.kde.Sdk
sdk-extensions:
  - org.freedesktop.Sdk.Extension.rust-stable
  - org.freedesktop.Sdk.Extension.openjdk
command: openbc
finish-args:
  - --share=ipc
  - --socket=wayland
  - --socket=fallback-x11
  - --device=dri          # 3D compare uses OpenGL
  - --share=network       # SFTP / FTP remote browsing
  - --filesystem=host     # comparing arbitrary folders is the point of the app
  - --socket=pulseaudio   # media compare playback
modules:
  - name: cfr
    buildsystem: simple
    build-commands:
      - install -Dm0644 cfr.jar /app/share/openbc/java/cfr.jar
      - install -Dm0644 CFR-LICENSE.txt /app/share/licenses/$FLATPAK_ID/cfr/CFR-LICENSE.txt
    sources:
      - type: file
        url: https://repo.maven.apache.org/maven2/org/benf/cfr/0.152/cfr-0.152.jar
        sha256: f686e8f3ded377d7bc87d216a90e9e9512df4156e75b06c655a16648ae8765b2
        dest-filename: cfr.jar
      - type: file
        path: CFR-LICENSE.txt
  - name: openbc
    buildsystem: cmake-ninja
    # Install the app module's license explicitly instead of relying on
    # flatpak-builder's automatic license-file detection.
    # Install both project license texts explicitly into the application image.
    post-install:
      - |
        set -eu
        find_license() {
          name="$1"
          for candidate in "$name" "../$name" "../../$name"; do
            if [ -f "$candidate" ]; then
              printf '%s\n' "$candidate"
              return 0
            fi
          done
          echo "ERROR: $name was not found in the source/build directory" >&2
          exit 1
        }
        install -Dm0644 "$(find_license LICENSE-MIT)" "$FLATPAK_DEST/share/licenses/$FLATPAK_ID/openbc/LICENSE-MIT"
        install -Dm0644 "$(find_license LICENSE-APACHE)" "$FLATPAK_DEST/share/licenses/$FLATPAK_ID/openbc/LICENSE-APACHE"
    build-options:
      append-path: /usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/openjdk/bin
      env:
        CARGO_HOME: /run/build/openbc/cargo
        CARGO_NET_OFFLINE: 'true'
    config-opts:
      - -DCMAKE_BUILD_TYPE=Release
      - -DCPACK_PACKAGE_VERSION=@APP_VERSION@
      - -DFETCHCONTENT_FULLY_DISCONNECTED=ON
      - -DFETCHCONTENT_SOURCE_DIR_CORROSION=/run/build/openbc/corrosion-src
    sources:
      # 1. App source the tag rendered into @APP_TAG@.
      # Replace the commit placeholder with the verified 40-character tag target SHA.
      - type: git
        url: https://github.com/devopsnextgenx/open-bc.git
        tag: @APP_TAG@
        commit: @APP_COMMIT@

      # 2. Offline Rust dependencies generated from this release's Cargo.lock.
      - cargo-sources.json

      # 3. Local Corrosion checkout prevents FetchContent from cloning at build time.
      # Replace the commit placeholder with the verified 40-character tag target SHA.
      - type: git
        url: https://github.com/corrosion-rs/corrosion.git
        tag: v0.6.1
        commit: @CORROSION_COMMIT@
        dest: corrosion-src
