[Desktop Entry]
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
MimeType=all/allfiles;
Actions=OpenBCSelectLeftFile;
X-KDE-Submenu=openbc
Icon=io.github.devopsnextgenx.open-bc

# "openbc: Compare To <left item name>" is deliberately not listed: the running OpenBC writes
# openbc-compare-to-left-file.desktop next to this file while a left file is selected.

[Desktop Action OpenBCSelectLeftFile]
Name=openbc: Select Left File
Icon=document-open
Exec=@OPENBC_FM_EXEC@ --select-left-file %f
