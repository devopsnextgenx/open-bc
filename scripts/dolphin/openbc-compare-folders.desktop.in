[Desktop Entry]
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
MimeType=inode/directory;
Actions=OpenBCSelectLeftFolder;
X-KDE-Submenu=openbc
Icon=io.github.devopsnextgenx.open-bc

# "openbc: Compare To Left Folder" is deliberately not listed: the running OpenBC writes
# openbc-compare-to-left-folder.desktop next to this file while a left folder is selected.

[Desktop Action OpenBCSelectLeftFolder]
Name=openbc: Select Left Folder
Icon=folder-open
Exec=@OPENBC_FM_EXEC@ --select-left-folder %f
