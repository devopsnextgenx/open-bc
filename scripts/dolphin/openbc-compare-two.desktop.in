[Desktop Entry]
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
MimeType=all/all;
X-KDE-MinNumberOfUrls=2
X-KDE-MaxNumberOfUrls=2
Actions=OpenBCCompareTwo;
X-KDE-Submenu=openbc
Icon=io.github.devopsnextgenx.open-bc

[Desktop Action OpenBCCompareTwo]
Name=openbc: Compare
Icon=view-split-left-right
Exec=@OPENBC_FM_EXEC@ %F
